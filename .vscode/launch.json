{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Shopping Agent (Setup)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--setup"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Shopping Agent (Run)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--shop"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Shopping Agent (Custom File)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--shop", "--file", "data/parts_list.json"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: View Report",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--report"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
