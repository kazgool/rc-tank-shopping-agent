# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Browser Configuration
HEADLESS_MODE=False  # Set to True to run browser in background

# Shopping Platforms (optional - for login functionality)
# Leave empty if you want to search without logging in
AMAZON_EMAIL=
AMAZON_PASSWORD=

EMAG_EMAIL=
EMAG_PASSWORD=

TEMU_EMAIL=
TEMU_PASSWORD=

# Rate Limiting (in seconds)
MIN_DELAY_BETWEEN_ACTIONS=2
MAX_DELAY_BETWEEN_ACTIONS=5

# Search Configuration
MAX_PRODUCTS_TO_ANALYZE=5  # Number of products to analyze per platform

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
